# Copia este archivo como .env y completa los valores. NO subas .env a GitHub.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En AWS agrega la IP elastica a ALLOWED_HOSTS y define CSRF_TRUSTED_ORIGINS=https://X.X.X.X
USE_HTTPS=False

# postgres o sqlite (sqlite sirve para probar rapido sin instalar PostgreSQL)
DB_ENGINE=sqlite
DB_NAME=nuam
DB_USER=nuam
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432    

MONGO_URI=mongodb://localhost:27017
MONGO_DB=nuam_nosql
MONGO_COLLECTION=certificados_externos
